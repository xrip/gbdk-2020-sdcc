diff --git a/src/z80/peeph-sm83.def b/src/z80/peeph-sm83.def
index c9755f3..c64e429 100644
--- sdcc/src/z80/peeph-sm83.def
+++ sdcc/src/z80/peeph-sm83.def
@@ -516,3 +516,28 @@ replace {
 	; peephole sp10c increased SP by 2 through pop
 	pop	%3
 } if unusedReg(%3 'bc' 'de' 'hl')
+
+// A is overwritten by carry materialization, so SBC A,A may use any old A.
+// Both forms return !C. The replacement can change H and C; require all
+// flags to be dead. This rule belongs only to SM83, not generic Z80 rules.
+replace {
+	ld	a, #0x00
+	rla
+	xor	a, #0x01
+} by {
+	; sm83 peephole bool1 materialized inverted carry directly
+	sbc	a, a
+	inc	a
+} if notUsed('f')
+
+// A masked bit is already 0 or 1. After bool1, remove its redundant
+// normalization. Keep the AND, and require dead flags for this rewrite too.
+replace {
+	and	a, #0x01
+	sub	a, #0x01
+	sbc	a, a
+	inc	a
+} by {
+	; sm83 peephole bool2 removed redundant normalization of one bit
+	and	a, #0x01
+} if notUsed('f')
