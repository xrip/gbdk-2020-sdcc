--- sdcc/src/z80/peeph-sm83.def
+++ sdcc/src/z80/peeph-sm83.def
@@ -541,3 +541,24 @@
 	; sm83 peephole bool2 removed redundant normalization of one bit
 	and	a, #0x01
 } if notUsed('f')
+
+// With bit 7 discarded, a short accumulator rotate gives the same byte
+// as SRL or SRA. The final AND also overwrites all SM83 flags, so the
+// replacement is valid even when flags are live after this sequence.
+replace {
+	srl	a
+	and	a, #%1
+} by {
+	; sm83 peephole maskshift1 used short rotate before a low-bit mask
+	rrca
+	and	a, #%1
+} if operandsLiteral(%1), immdInRange(0 127 '+' %1 0 %2)
+
+replace {
+	sra	a
+	and	a, #%1
+} by {
+	; sm83 peephole maskshift2 used short rotate before a low-bit mask
+	rrca
+	and	a, #%1
+} if operandsLiteral(%1), immdInRange(0 127 '+' %1 0 %2)
